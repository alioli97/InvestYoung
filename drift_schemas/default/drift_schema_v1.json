  "fixed_sql": [
    {
      "name": "user_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"age_range\" TEXT NOT NULL, \"employment\" TEXT NOT NULL, \"monthly_income_cents\" INTEGER NULL, \"has_dependents\" INTEGER NOT NULL CHECK (\"has_dependents\" IN (0, 1)), \"has_high_interest_debt\" INTEGER NOT NULL CHECK (\"has_high_interest_debt\" IN (0, 1)), \"debt_cents\" INTEGER NULL, \"risk_score\" INTEGER NOT NULL, \"risk_profile\" TEXT NOT NULL, \"knowledge_level\" TEXT NOT NULL, \"emergency_months\" INTEGER NOT NULL, \"locale\" TEXT NOT NULL, \"onboarding_completed_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "monthly_expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"monthly_expenses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"target_cents\" INTEGER NOT NULL, \"target_date\" TEXT NULL, \"expected_annual_return\" REAL NOT NULL DEFAULT 0.0, \"params_json\" TEXT NOT NULL DEFAULT '{}', \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"goal_id\" INTEGER NULL REFERENCES goals (id) ON DELETE SET NULL, \"metadata_json\" TEXT NOT NULL DEFAULT '{}', \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"asset_id\" INTEGER NOT NULL REFERENCES assets (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"quantity\" TEXT NULL, \"fee_cents\" INTEGER NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "lesson_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_progress\" (\"lesson_id\" TEXT NOT NULL, \"read_at\" TEXT NULL, \"quiz_passed_at\" TEXT NULL, PRIMARY KEY (\"lesson_id\"));"
        }
      ]
    }
  ]
